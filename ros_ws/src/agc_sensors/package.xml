<?xml version="1.0"?>
<package format="3">
  <name>agc_sensors</name>
  <version>0.1.0</version>
  <description>Sensor interface package for AGC GPS and Compass</description>

  <maintainer email="erik.labrot@uwf.edu">Erik LaBrot</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>pyserial</exec_depend>
  <exec_depend>smbus2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
