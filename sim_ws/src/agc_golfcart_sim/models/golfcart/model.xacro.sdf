<?xml version="1.0"?>
<robot name="uwf_golfcart">
  <sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <model name="uwf_golfcart">
      <!-- Chassis/Base Link -->
      <link name="chassis">
        <pose>0 0 1.11 0 0 0</pose> <!-- Raised to: wheel_radius + chassis_height/2 + ground_clearance -->
        <inertial>
          <mass>499.9</mass> <!-- 1101 lbs dry weight -->
          <inertia>
            <ixx>166.0</ixx>
            <iyy>350.0</iyy>
            <izz>400.0</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        
        <collision name="chassis_collision">
          <geometry>
            <box>
              <size>3.13 0.75 0.75</size> <!-- L x W x H from specs -->
            </box>
          </geometry>
        </collision>
        
        <visual name="chassis_visual">
          <geometry>
            <box>
              <size>3.13 0.75 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1.0</ambient>
            <diffuse>0.2 0.5 0.8 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
        
        <!-- LiDAR Mount -->
        <visual name="lidar_mount">
          <pose>1.4 0 0.7 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      
      <!-- Front Left Wheel -->
      <link name="front_left_wheel">
        <pose>1.015 0.545 0.292 -1.5708 0 0</pose> <!-- At wheel radius height, rolled 90deg -->
        <inertial>
          <mass>15</mass>
          <inertia>
            <ixx>0.5</ixx>
            <iyy>0.5</iyy>
            <izz>0.5</izz>
          </inertia>
        </inertial>
        
        <collision name="front_left_wheel_collision">
          <geometry>
            <cylinder>
              <radius>0.292</radius> <!-- 23" diameter / 2 -->
              <length>0.267</length> <!-- 10.5" width -->
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>0.6</mu2>
              </ode>  
            </friction>
          </surface>
        </collision>
        
        <visual name="front_left_wheel_visual">
          <geometry>
            <cylinder>
              <radius>0.292</radius>
              <length>0.267</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Front Left Steering Joint -->
      <link name="front_left_steering_link">
        <pose>1.015 0.545 0.292 0 0 0</pose>
      </link>

      <!-- Front Right Wheel -->
      <link name="front_right_wheel">
        <pose>1.015 -0.545 0.292 -1.5708 0 0</pose>
        <inertial>
          <mass>15</mass>
          <inertia>
            <ixx>0.5</ixx>
            <iyy>0.5</iyy>
            <izz>0.5</izz>
          </inertia>
        </inertial>
        
        <collision name="front_right_wheel_collision">
          <geometry>
            <cylinder>
              <radius>0.292</radius>
              <length>0.267</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        
        <visual name="front_right_wheel_visual">
          <geometry>
            <cylinder>
              <radius>0.292</radius>
              <length>0.267</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Front Right Steering Linkage -->
      <link name="front_right_steering_link">
        <pose>1.015 -0.545 0.292 0 0 0</pose>
      </link>
      
      <!-- Rear Left Wheel -->
      <link name="rear_left_wheel">
        <pose>-1.015 0.55 0.292 -1.5708 0 0</pose> <!-- At wheel radius height, rolled 90deg -->
        <inertial>
          <mass>15</mass>
          <inertia>
            <ixx>0.5</ixx>
            <iyy>0.5</iyy>
            <izz>0.5</izz>
          </inertia>
        </inertial>
        
        <collision name="rear_left_wheel_collision">
          <geometry>
            <cylinder>
              <radius>0.292</radius>
              <length>0.267</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        
        <visual name="rear_left_wheel_visual">
          <geometry>
            <cylinder>
              <radius>0.292</radius>
              <length>0.267</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      
      <!-- Rear Right Wheel -->
      <link name="rear_right_wheel">
        <pose>-1.015 -0.55 0.292 1.5708 0 0</pose>
        <inertial>
          <mass>15</mass>
          <inertia>
            <ixx>0.5</ixx>
            <iyy>0.5</iyy>
            <izz>0.5</izz>
          </inertia>
        </inertial>
        
        <collision name="rear_right_wheel_collision">
          <geometry>
            <cylinder>
              <radius>0.292</radius>
              <length>0.267</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        
        <visual name="rear_right_wheel_visual">
          <geometry>
            <cylinder>
              <radius>0.292</radius>
              <length>0.267</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      

      <!-- Front Left Steering Joint (chassis -> knuckle, vertical axis) -->
      <joint name="front_left_steering_joint" type="revolute">
        <parent>chassis</parent>
        <child>front_left_steering_link</child>
        <axis>
          <xyz>0 1 0</xyz> <!-- Vertical steering axis in your coordinate system -->
          <limit>
            <lower>-0.785</lower> <!-- ~45 degrees -->
            <upper>0.785</upper>
            <effort>100</effort>
          </limit>
        </axis>
      </joint>

      <!-- Front Left Wheel Joint (knuckle -> wheel, rotation axis) -->
      <joint name="front_left_wheel_joint" type="revolute">
        <parent>front_left_steering_link</parent>
        <child>front_left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz> <!-- Wheel rotation axis -->
        </axis>
      </joint>

      <!-- Front Right Steering Joint (chassis -> knuckle, vertical axis) -->
      <joint name="front_right_steering_joint" type="revolute">
        <parent>chassis</parent>
        <child>front_right_steering_link</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-0.785</lower>
            <upper>0.785</upper>
            <effort>100</effort>
          </limit>
        </axis>
      </joint>

      <!-- Front Right Wheel Joint (knuckle -> wheel, rotation axis) -->
      <joint name="front_right_wheel_joint" type="revolute">
        <parent>front_right_steering_link</parent>
        <child>front_right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
        </axis>
      </joint>

      <!-- Rear Left Wheel Joint -->
      <joint name="rear_left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>rear_left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz> <!-- Rotation axis -->
        </axis>
      </joint>
      
      <!-- Rear Right Wheel Joint -->
      <joint name="rear_right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>rear_right_wheel</child>
        <axis>
          <xyz>0 0 -1</xyz>
        </axis>
      </joint>
      
      <!-- LiDAR Sensor (SICK LMS200) -->
      <link name="lidar_link">
        <pose>1.4 0 0.7 0 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        
        <collision name="lidar_collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
        </collision>
        
        <visual name="lidar_visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
        
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0 0 0 0</pose>
          <topic>lidar</topic>
          <update_rate>10</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>361</samples>
                <resolution>1</resolution>
                <min_angle>-1.5708</min_angle> 
                <max_angle>1.5708</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.1</min>
              <max>80.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </lidar>
          <always_on>1</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>
      
      <joint name="lidar_joint" type="fixed">
        <parent>chassis</parent>
        <child>lidar_link</child>
      </joint>
      
      <!-- GPS Sensor -->
      <link name="gps_link">
        <pose>0 0 1.0 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
        
        <sensor name="gps" type="navsat">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>gps</topic>
          <navsat>
            <position_sensing>
              <horizontal>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>2.0</stddev> <!-- 2m GPS error -->
                </noise>
              </horizontal>
              <vertical>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>3.0</stddev>
                </noise>
              </vertical>
            </position_sensing>
          </navsat>
        </sensor>
      </link>
      
      <joint name="gps_joint" type="fixed">
        <parent>chassis</parent>
        <child>gps_link</child>
      </joint>
      
      <!-- IMU Sensor (for compass/heading) -->
      <link name="imu_link">
        <pose>0 0 0.5 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
        
        <sensor name="imu" type="imu">
          <always_on>1</always_on>
          <update_rate>100</update_rate>
          <topic>imu</topic>
          <imu>
            <angular_velocity>
              <x>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.01</stddev>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.01</stddev>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.01</stddev>
                </noise>
              </z>
            </angular_velocity>
            <linear_acceleration>
              <x>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.1</stddev>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.1</stddev>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.1</stddev>
                </noise>
              </z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>
      
      <joint name="imu_joint" type="fixed">
        <parent>chassis</parent>
        <child>imu_link</child>
      </joint>
   
      <!-- Joint State Publisher -->
      <plugin
        filename="ignition-gazebo-joint-state-publisher-system"
        name="ignition::gazebo::systems::JointStatePublisher">
        <joint_name>rear_left_wheel_joint</joint_name>
        <joint_name>rear_right_wheel_joint</joint_name>
        <joint_name>front_left_wheel_joint</joint_name>
        <joint_name>front_right_wheel_joint</joint_name>
        <joint_name>front_left_steering_joint</joint_name>
        <joint_name>front_right_steering_joint</joint_name>
        <topic>/joint_states</topic>
        <update_rate>50</update_rate>
      </plugin>
      
      <!-- Pose Publisher (for odometry) -->
      <plugin
        filename="ignition-gazebo-pose-publisher-system"
        name="ignition::gazebo::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
        <static_update_frequency>1</static_update_frequency>
      </plugin>

      <!-- ros2_control Hardware Interface -->
      <ros2_control name="GazeboSystem" type="system">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        
        <!-- Steering Joints (Effort Control) -->
        <joint name="front_left_steering_joint">
          <command_interface name="effort"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        
        <joint name="front_right_steering_joint">
          <command_interface name="effort"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        
        <!-- Wheel Joints (Velocity Control) -->
        <joint name="front_left_wheel_joint">
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        
        <joint name="front_right_wheel_joint">
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        
        <joint name="rear_left_wheel_joint">
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        
        <joint name="rear_right_wheel_joint">
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>

      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>/root/sim_ws/install/agc_golfcart_sim/share/agc_golfcart_sim/config/ros2_controllers.yaml</parameters>
      </plugin>

    </model>
  </sdf>
</robot>